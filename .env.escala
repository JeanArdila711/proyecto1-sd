# Clúster con 5 DataNodes en vez de 3 (evidencia de escalabilidad: docs/escalabilidad.md).
# Se usa encima de .env, en TODOS los comandos de esa sesión:
#   docker compose --env-file .env --env-file .env.escala up -d
#   docker compose --env-file .env --env-file .env.escala run --rm inspect mapa
COMPOSE_PROFILES=escala
DFSHA_DATANODE_COUNT=5
DFSHA_DATANODES=dn1:50061,dn2:50061,dn3:50061,dn4:50061,dn5:50061
