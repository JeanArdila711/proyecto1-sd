   "type": "text",
   "x": 60,
   "y": 1440,
   "width": 187.00000000000003,
   "height": 42.5,
   "text": "2 · Flujos",
   "originalText": "2 · Flujos",
   "fontSize": 34,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "angle": 0,
   "strokeColor": "#868e96",
