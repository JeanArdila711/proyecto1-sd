# Parámetros del clúster. Docker Compose lee este archivo solo.
# Después de cambiarlo: docker compose up -d

DFSHA_BLOCK_MB=128          # tamaño de bloque en MB (para la demo: 1)
DFSHA_REPLICATION=3         # réplicas por bloque (para ver el reparto con 3 DataNodes: 2)
DFSHA_UPLOAD_LEASE_S=600    # segundos para liberar una subida abandonada (para la demo: 15)

# Hito 3 A1: liveness pull y mínimo de copias confirmadas
DFSHA_MIN_WRITE_REPLICAS=2
DFSHA_HEARTBEAT_INTERVAL_S=2
DFSHA_DATANODE_DEAD_AFTER_S=6

# Re-replicación A2
DFSHA_REREPLICATION_INTERVAL_S=10
DFSHA_REREPLICATION_DELAY_S=30
DFSHA_REREPLICATION_MAX_PER_CYCLE=4
DFSHA_GC_INTERVAL_S=60               # cada cuánto el recolector busca bloques huérfanos
DFSHA_GC_GRACE_S=1200                # edad mínima de un bloque sin uso para borrarlo (para la demo: 5)
